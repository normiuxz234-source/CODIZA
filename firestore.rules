rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Ping / connection test document
    match /test/connection {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSettings(data) {
      return data.userId is string && data.userId.size() <= 128
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 200))
        && (!('tradeName' in data) || (data.tradeName is string && data.tradeName.size() <= 200))
        && (!('taxId' in data) || (data.taxId is string && data.taxId.size() <= 30))
        && (!('taxRegime' in data) || (data.taxRegime is string && data.taxRegime.size() <= 100))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1000000));
    }

    function isValidDocument(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.docType in ['factura', 'remision', 'nota_venta']
        && data.folio is string && data.folio.size() <= 50
        && data.status in ['borrador', 'emitida', 'pagada', 'pendiente', 'cancelada']
        && data.total is number;
    }

    function isValidClient(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() <= 200;
    }

    function isValidUserProfile(data) {
      return data.email is string && data.email.size() <= 100
        && data.role in ['admin', 'facturador', 'auditor']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('status' in data) || data.status in ['activo', 'inactivo', 'pendiente']);
    }

    // User profiles & authorized team members
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isSignedIn() && (
        userId == request.auth.uid ||
        request.auth.token.email == 'normiuxz234@gmail.com'
      );
    }

    // Company settings
    match /settings/{settingId} {
      allow get: if isSignedIn() && (
        settingId == request.auth.uid ||
        settingId == 'company_' + request.auth.uid ||
        resource == null ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(settingId) && incoming().userId == request.auth.uid && isValidSettings(incoming());
      allow update: if isSignedIn() && isValidId(settingId) && incoming().userId == request.auth.uid && isValidSettings(incoming());
      allow delete: if isSignedIn() && (settingId == request.auth.uid || settingId == 'company_' + request.auth.uid || existing().userId == request.auth.uid);
    }

    // Invoices, Remisiones, Sales Notes
    match /documents/{documentId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(documentId) && incoming().userId == request.auth.uid && isValidDocument(incoming());
      allow update: if isSignedIn() && isValidId(documentId) && incoming().userId == request.auth.uid && isValidDocument(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Client records
    match /clients/{clientId} {
      allow get: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(clientId) && incoming().userId == request.auth.uid && isValidClient(incoming());
      allow update: if isSignedIn() && isValidId(clientId) && incoming().userId == request.auth.uid && isValidClient(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}

